{
  "name": "unbag",
  "version": "0.6.2",
  "description": "一个专门用来开发npm工具的包",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build:unbag": "tsx ./src/run.ts transform",
    "build": "pnpm build:unbag",
    "dev:unbag": "tsx ./src/run.ts transform -w",
    "docs:build": "pnpm --filter 'unbag-docs' build",
    "dev": "tsx ./src/run.ts parallel",
    "ci:version": "changeset version",
    "ci:publish": "pnpm build && changeset publish",
    "clear": "rimraf 'packages/*/{lib,node_modules}' && rimraf node_modules",
    "commit": "tsx ./src/run.ts commit",
    "commitLint": "tsx ./src/run.ts commit lint",
    "test": "echo 'test'",
    "bump": "pnpm conventional-recommended-bump -p conventionalcommits",
    "release": "pnpm commit-and-tag-version"
  },
  "license": "MIT",
  "author": "LiuWenXing1996 lwx_redstone@163.com",
  "keywords": [
    "unbundle",
    "bundleless",
    "npm tool"
  ],
  "files": [
    "dist"
  ],
  "bin": {
    "unbag": "./dist/esm/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "types": "./dist/types/default/index.d.ts",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "dependencies": {
    "@babel/core": "^7.24.7",
    "@babel/plugin-syntax-typescript": "^7.24.7",
    "@commitlint/config-conventional": "^19.4.1",
    "@commitlint/cz-commitlint": "^19.2.0",
    "@commitlint/lint": "^19.2.2",
    "@commitlint/load": "^19.2.0",
    "@commitlint/types": "^19.0.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "bundle-require": "^4.0.2",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^10.0.0",
    "commitizen": "^4.3.0",
    "concurrently": "^8.2.2",
    "conventional-changelog": "^6.0.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "conventional-commits-parser": "^6.0.0",
    "conventional-recommended-bump": "^10.0.0",
    "dayjs": "^1.11.11",
    "debounce-promise": "^3.1.2",
    "deep-freeze-strict": "^1.1.1",
    "detect-indent": "^7.0.1",
    "detect-newline": "^4.0.1",
    "esbuild": "^0.20.1",
    "execa": "^9.2.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.0.0",
    "lodash": "^4.17.21",
    "semver": "^7.6.2",
    "ts-essentials": "^10.0.2",
    "typescript": "~5.1.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.24.8",
    "@commitlint/config-pnpm-scopes": "^19.1.0",
    "@types/babel__core": "^7.20.5",
    "@types/conventional-changelog": "^3.1.5",
    "@types/debounce-promise": "^3.1.9",
    "@types/deep-freeze-strict": "^1.1.2",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.14.202",
    "@types/semver": "^7.5.8",
    "@types/uuid": "^9.0.2",
    "@types/wait-on": "^5.3.4",
    "babel-plugin-add-import-extension": "^1.6.0",
    "husky": "^9.0.11",
    "tsx": "^4.7.1",
    "wait-on": "^7.2.0"
  }
}